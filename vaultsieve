#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
VENV_COMMAND="$SCRIPT_DIR/.venv/bin/vaultsieve"

if [ ! -x "$VENV_COMMAND" ]; then
  printf '%s\n' "VaultSieve is not installed in .venv."
  printf '%s\n' "Run: python3 -m venv .venv && .venv/bin/python -m pip install -e '.[dev]'"
  exit 1
fi

exec "$VENV_COMMAND" "$@"
